generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  COORDINATOR
  RESPONDENT
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(RESPONDENT)
  createdAt DateTime @default(now())

  surveys   Survey[] 
  responses Response[]
}

model Survey {
  id            String   @id @default(uuid())
  title         String
  description   String?
  status        String   @default("DRAFT") // DRAFT, OPEN, CLOSED
  coordinatorId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  coordinator   User       @relation(fields: [coordinatorId], references: [id])
  questions     Question[]
}

model Question {
  id       String   @id @default(uuid())
  surveyId String
  text     String
  order    Int      

  survey   Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  options  Option[]
}

model Option {
  id         String   @id @default(uuid())
  questionId String
  text       String

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  responses  Response[]
}

model Response {
  id         String   @id @default(uuid())
  userId     String
  optionId   String
  surveyId   String   
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
  option     Option   @relation(fields: [optionId], references: [id])
  
  @@unique([userId, surveyId]) // Um usuário só vota uma vez por pesquisa
}